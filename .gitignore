# Python
__pycache__/
*.py[cod]
.venv/
dist/
build/

# Tooling
.pytest_cache/
.python-version
.ruff_cache/
.coverage
# pytest-xdist writes one data file per worker and combines them at the end;
# an interrupted run leaves them behind, and publish() commits every untracked
# file that is not ignored.
.coverage.*
coverage.xml
coverage.json
reports/
mutants/
site/

# Runtime state
orchestrator_state.json
orchestrator_state.json*.lock
orchestrator_state.json.locks/
orchestrator_state.json.tmp
# Anywhere, not just next to the driver: go.sh redirects are relative to the
# directory the run was launched from, so a run started at the repository
# root used to drop every agent log here and the old path-scoped rule missed
# them. No .log file in this repo is ever meant to be committed.
*.log
examples/gabriels_workflow_v3/spectacle.prompt

# Editor
.idea/
.vscode/
